{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/sairaph/detect-harness/protocol/request.schema.json",
  "title": "detect-harness request",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "operation"],
  "properties": {
    "version": { "const": 1 },
    "operation": { "enum": ["detect", "render", "update"] },
    "server": { "$ref": "#/$defs/stdioServer" },
    "harness": { "$ref": "#/$defs/harnessId" },
    "harnesses": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/harnessId" }
    },
    "desired": { "enum": ["present", "absent"] },
    "conflictPolicy": { "enum": ["error", "replace"] },
    "scope": { "$ref": "#/$defs/scope" },
    "dryRun": { "type": "boolean" }
  },
  "allOf": [
    {
      "if": { "properties": { "operation": { "const": "render" } }, "required": ["operation"] },
      "then": { "required": ["server", "harness"] }
    },
    {
      "if": { "properties": { "operation": { "const": "update" } }, "required": ["operation"] },
      "then": { "required": ["server", "harnesses", "desired"] }
    }
  ],
  "$defs": {
    "harnessId": {
      "enum": [
        "claude-desktop",
        "claude-code",
        "cursor",
        "codex",
        "gemini-cli",
        "windsurf",
        "zed",
        "cline",
        "roo-code",
        "zoo-code",
        "amazon-q",
        "continue",
        "opencode",
        "vscode"
      ]
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "dir"],
      "properties": {
        "mode": { "const": "project" },
        "dir": { "type": "string", "minLength": 1, "pattern": "\\S" }
      }
    },
    "stdioServer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "command"],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$",
          "not": { "enum": ["__proto__", "constructor", "toString"] }
        },
        "command": { "type": "string", "pattern": "\\S", "not": { "pattern": "\\u0000" } },
        "args": {
          "type": "array",
          "items": { "type": "string", "not": { "pattern": "\\u0000" } }
        },
        "env": {
          "type": "object",
          "propertyNames": { "pattern": "^[^=\\u0000]+$" },
          "additionalProperties": { "type": "string", "not": { "pattern": "\\u0000" } }
        }
      }
    }
  }
}
